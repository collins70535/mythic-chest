# Add these in Vercel under Project Settings -> Environment Variables.
# Never commit a real Stripe secret key.
STRIPE_SECRET_KEY=sk_test_replace_me
PUBLIC_SITE_URL=https://www.mythicchest.com

# Browser publishable key only (pk_...). Never put sk_ or whsec here.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Keep this true only after Stripe Tax is configured for the jurisdictions
# where Mythic Chest is registered to collect sales tax.
STRIPE_AUTOMATIC_TAX=false

# CHEST P1 TEST spike — DEFAULT OFF. Do not enable in production LIVE.
# Server: when true, create-hall-of-fame-checkout-session uses ui_mode=embedded_page
# and returns { clientSecret }. When false/unset, hosted redirect { url } is unchanged.
HOF_EMBEDDED_CHECKOUT=false
# Client: when true, HoF order form routes to /hall-of-fame-2026/pay (Mythic shell).
VITE_HOF_EMBEDDED_CHECKOUT=false
